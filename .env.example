# Copy this file to .env and fill in real values for the new store.
# Never commit the real .env - it's gitignored.

# Generate a fresh random value per store - do not reuse another store's.
SESSION_SECRET=

# Shopify admin -> Settings -> Apps and sales channels -> Develop apps
# -> [app] -> API credentials -> Storefront API
PUBLIC_STORE_DOMAIN=your-store.myshopify.com
PUBLIC_STOREFRONT_API_TOKEN=
PRIVATE_STOREFRONT_API_TOKEN=
